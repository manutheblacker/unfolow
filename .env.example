# Copy to .env and fill in. Keep .env at mode 600; it is gitignored.
#   cp .env.example .env && chmod 600 .env
IG_USERNAME="your_login"
IG_PASSWORD="your_password"

# Intentionally absent: IG_VERIFICATION_CODE.
# A TOTP code dies within 30 seconds, so a saved one only breaks things. Export
# it per-run when a non-interactive login needs it:
#   export IG_VERIFICATION_CODE=123456
